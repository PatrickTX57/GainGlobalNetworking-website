---
export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Gain Global Networking',
  description = "Gain Global Networking is a referral networking community built on consistency and accountability — turning a room of strangers into deep relationships, lasting referral partners, and lifelong friends.",
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>
</head>
<body>
  <slot />
</body>
</html>

<style is:global>
  :root {
    --navy: #12233f;
    --navy-deep: #0a1830;
    --gold: #c89a4c;
    --gold-light: #e3c07f;
    --ink: #1c2531;
    --slate: #5b6472;
    --cream: #faf7f1;
    --line: #e6e0d4;
    --white: #ffffff;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body {
    font-family: 'Georgia', 'Iowan Old Style', serif;
    color: var(--ink);
    background: var(--cream);
    line-height: 1.6;
  }
  h1, h2, h3, h4 { font-family: 'Helvetica Neue', Arial, sans-serif; letter-spacing: 0.01em; }
  .sans { font-family: 'Helvetica Neue', Arial, sans-serif; }
  a { color: inherit; text-decoration: none; }
  img { max-width: 100%; display: block; }
  .wrap { max-width: 1080px; margin: 0 auto; padding: 0 28px; }

  /* NAV */
  header.nav {
    position: sticky; top: 0; z-index: 50;
    background: rgba(10, 24, 48, 0.96);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid rgba(200,154,76,0.25);
  }
  header.nav .wrap {
    display: flex; align-items: center; justify-content: space-between;
    height: 68px;
  }
  .brand {
    font-family: 'Helvetica Neue', Arial, sans-serif;
    color: var(--white);
    font-weight: 700; font-size: 18px; letter-spacing: 0.04em;
    display: flex; align-items: center; gap: 10px;
  }
  .brand .mark {
    width: 30px; height: 30px; border-radius: 50%;
    background: linear-gradient(135deg, var(--gold-light), var(--gold));
    display: flex; align-items: center; justify-content: center;
    color: var(--navy-deep); font-weight: 800; font-size: 14px;
  }
  nav.links { display: flex; gap: 28px; font-family: 'Helvetica Neue', Arial, sans-serif; }
  nav.links a {
    color: #d8ddea; font-size: 14px; font-weight: 500; transition: color .2s;
  }
  nav.links a:hover { color: var(--gold-light); }
  .nav-cta {
    background: var(--gold); color: var(--navy-deep) !important; padding: 9px 18px;
    border-radius: 3px; font-weight: 700 !important; font-size: 13px !important;
  }
  .nav-toggle { display: none; }

  /* HERO */
  .hero {
    background:
      radial-gradient(circle at 15% 20%, rgba(200,154,76,0.16), transparent 45%),
      linear-gradient(160deg, var(--navy-deep) 0%, var(--navy) 60%, #16294a 100%);
    color: var(--white);
    padding: 110px 0 130px;
    position: relative;
    overflow: hidden;
  }
  .hero::after {
    content: "";
    position: absolute; right: -120px; top: -80px;
    width: 420px; height: 420px; border-radius: 50%;
    border: 1px solid rgba(227,192,127,0.18);
  }
  .hero::before {
    content: "";
    position: absolute; right: -40px; top: 40px;
    width: 300px; height: 300px; border-radius: 50%;
    border: 1px solid rgba(227,192,127,0.14);
  }
  .eyebrow {
    font-family: 'Helvetica Neue', Arial, sans-serif;
    text-transform: uppercase; letter-spacing: 0.22em; font-size: 12px;
    color: var(--gold-light); font-weight: 600; margin-bottom: 20px;
  }
  .hero h1 {
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-size: 52px; font-weight: 800; line-height: 1.08; max-width: 720px;
  }
  .hero h1 em { color: var(--gold-light); font-style: normal; }
  .hero p.lead {
    font-family: 'Helvetica Neue', Arial, sans-serif;
    margin-top: 22px; font-size: 19px; color: #c6cde0; max-width: 560px; font-weight: 300;
  }
  .hero-actions { margin-top: 38px; display: flex; gap: 16px; flex-wrap: wrap; }
  .btn {
    font-family: 'Helvetica Neue', Arial, sans-serif;
    display: inline-block; padding: 14px 28px; border-radius: 3px;
    font-weight: 700; font-size: 14px; letter-spacing: 0.02em; transition: all .2s;
    border: none; cursor: pointer;
  }
  .btn-primary { background: var(--gold); color: var(--navy-deep); }
  .btn-primary:hover { background: var(--gold-light); }
  .btn-outline { border: 1px solid rgba(255,255,255,0.35); color: var(--white); background: transparent; }
  .btn-outline:hover { border-color: var(--gold-light); color: var(--gold-light); }

  .hero-meeting {
    margin-top: 56px; display: inline-flex; align-items: center; gap: 14px;
    background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.14);
    padding: 14px 22px; border-radius: 4px; font-family: 'Helvetica Neue', Arial, sans-serif;
  }
  .hero-meeting .dot { width: 8px; height: 8px; border-radius: 50%; background: #6fd08c; flex-shrink: 0; }
  .hero-meeting span { font-size: 14px; color: #dfe4ef; }
  .hero-meeting strong { color: var(--white); }

  /* SECTION HEADERS */
  .section { padding: 90px 0; }
  .section.alt { background: var(--white); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .kicker {
    font-family: 'Helvetica Neue', Arial, sans-serif;
    text-transform: uppercase; letter-spacing: 0.18em; font-size: 12px;
    color: var(--gold); font-weight: 700; margin-bottom: 14px;
  }
  .section h2 {
    font-size: 34px; font-weight: 800; color: var(--navy-deep); max-width: 640px;
  }
  .section p.section-lead {
    margin-top: 16px; color: var(--slate); font-size: 17px; max-width: 640px;
  }

  /* DIFFERENT SECTION */
  .diff-grid {
    display: grid; grid-template-columns: 1fr 1fr; gap: 40px; margin-top: 56px;
  }
  .diff-card {
    padding: 32px; border-radius: 6px;
  }
  .diff-card.no { background: #f1eee6; border: 1px dashed #c9c1ac; }
  .diff-card.yes { background: var(--navy-deep); color: var(--white); }
  .diff-card h3 {
    font-size: 13px; text-transform: uppercase; letter-spacing: 0.14em; margin-bottom: 18px;
    font-family: 'Helvetica Neue', Arial, sans-serif;
  }
  .diff-card.no h3 { color: #8b8262; }
  .diff-card.yes h3 { color: var(--gold-light); }
  .diff-card ul { list-style: none; }
  .diff-card li { padding: 10px 0; border-bottom: 1px solid rgba(0,0,0,0.06); font-size: 16px; }
  .diff-card.yes li { border-bottom: 1px solid rgba(255,255,255,0.1); }
  .diff-card li:last-child { border-bottom: none; }

  .formula {
    margin-top: 60px; text-align: center; background: var(--cream);
    border: 1px solid var(--line); border-radius: 8px; padding: 40px 20px;
  }
  .formula .sans { font-size: 13px; text-transform: uppercase; letter-spacing: 0.16em; color: var(--slate); font-weight: 700; }
  .formula-row {
    margin-top: 22px; display: flex; align-items: center; justify-content: center;
    gap: 18px; flex-wrap: wrap; font-family: 'Helvetica Neue', Arial, sans-serif;
    font-weight: 800; font-size: 20px; color: var(--navy-deep);
  }
  .formula-row .plus, .formula-row .eq { color: var(--gold); font-size: 22px; }
  .formula-outputs {
    margin-top: 26px; display: flex; justify-content: center; gap: 14px; flex-wrap: wrap;
  }
  .chip {
    font-family: 'Helvetica Neue', Arial, sans-serif; font-size: 13px; font-weight: 600;
    background: var(--white); border: 1px solid var(--line); padding: 8px 16px;
    border-radius: 20px; color: var(--navy);
  }

  /* VALUES */
  .values-grid {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; margin-top: 56px;
  }
  .value-card {
    background: var(--cream); border: 1px solid var(--line); border-radius: 8px;
    padding: 30px 22px; text-align: center;
  }
  .value-card .glyph {
    width: 52px; height: 52px; border-radius: 50%; margin: 0 auto 18px;
    background: linear-gradient(135deg, var(--navy), var(--navy-deep));
    display: flex; align-items: center; justify-content: center;
    color: var(--gold-light); font-size: 20px; font-weight: 800; font-family: 'Helvetica Neue', Arial, sans-serif;
  }
  .value-card h4 { font-size: 16px; color: var(--navy-deep); margin-bottom: 8px; }
  .value-card p { font-size: 14px; color: var(--slate); }

  /* WHO NOT HOW */
  .quote-block {
    background: var(--navy-deep); color: var(--white); padding: 90px 0; text-align: center;
    position: relative;
  }
  .quote-block .mark-quote {
    font-size: 62px; font-family: Georgia, serif; color: var(--gold); line-height: 1;
  }
  .quote-block h2 {
    font-size: 40px; font-family: 'Helvetica Neue', Arial, sans-serif; font-weight: 800; margin-top: 6px;
  }
  .quote-block p { margin-top: 18px; color: #c6cde0; font-size: 17px; max-width: 560px; margin-left: auto; margin-right: auto; }

  /* MEMBERSHIP */
  .membership-grid {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; margin-top: 56px;
  }
  .membership-item {
    display: flex; gap: 18px; background: var(--cream); border: 1px solid var(--line);
    border-radius: 8px; padding: 24px;
  }
  .membership-item .num {
    font-family: 'Helvetica Neue', Arial, sans-serif; font-weight: 800; font-size: 22px;
    color: var(--gold); flex-shrink: 0; width: 34px;
  }
  .membership-item h4 { font-size: 16px; color: var(--navy-deep); margin-bottom: 6px; font-family: 'Helvetica Neue', Arial, sans-serif; }
  .membership-item p { font-size: 14px; color: var(--slate); }

  /* LEADERSHIP */
  .team-grid {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; margin-top: 56px;
  }
  .team-card { text-align: center; }
  .team-card .avatar {
    width: 96px; height: 96px; border-radius: 50%; margin: 0 auto 18px;
    background: linear-gradient(135deg, var(--gold-light), var(--gold));
    display: flex; align-items: center; justify-content: center;
    font-family: 'Helvetica Neue', Arial, sans-serif; font-weight: 800; font-size: 26px;
    color: var(--navy-deep);
  }
  .team-card h4 { font-size: 17px; color: var(--navy-deep); font-family: 'Helvetica Neue', Arial, sans-serif; }
  .team-card .role { font-size: 13px; color: var(--gold); font-weight: 700; margin-top: 4px; font-family: 'Helvetica Neue', Arial, sans-serif; text-transform: uppercase; letter-spacing: 0.05em; }
  .team-card .role2 { font-size: 13px; color: var(--slate); margin-top: 2px; font-family: 'Helvetica Neue', Arial, sans-serif; }

  /* APPLICATION / CTA */
  .apply {
    background: linear-gradient(160deg, var(--navy-deep), var(--navy));
    color: var(--white); border-radius: 12px; padding: 56px 48px;
  }
  .apply-top {
    display: flex; justify-content: space-between; align-items: center; gap: 40px; flex-wrap: wrap;
  }
  .apply h3 { font-size: 26px; font-family: 'Helvetica Neue', Arial, sans-serif; font-weight: 800; }
  .apply p { margin-top: 10px; color: #c6cde0; max-width: 420px; }
  .apply .price {
    font-family: 'Helvetica Neue', Arial, sans-serif; font-size: 44px; font-weight: 800; color: var(--gold-light);
  }
  .apply .price span { font-size: 15px; color: #c6cde0; font-weight: 400; display: block; margin-top: 4px; }

  /* CONTACT FORM */
  .apply-form {
    margin-top: 44px; padding-top: 40px; border-top: 1px solid rgba(255,255,255,0.14);
  }
  .apply-form h4 {
    font-family: 'Helvetica Neue', Arial, sans-serif; font-size: 18px; font-weight: 700;
    color: var(--white); margin-bottom: 18px;
  }
  .form-grid {
    display: grid; grid-template-columns: 1fr 1fr; gap: 16px;
  }
  .form-grid .full { grid-column: 1 / -1; }
  .apply-form label {
    display: block; font-family: 'Helvetica Neue', Arial, sans-serif; font-size: 12px;
    text-transform: uppercase; letter-spacing: 0.08em; color: #b9c1d6; margin-bottom: 6px; font-weight: 600;
  }
  .apply-form input,
  .apply-form textarea {
    width: 100%; padding: 12px 14px; border-radius: 4px; border: 1px solid rgba(255,255,255,0.2);
    background: rgba(255,255,255,0.06); color: var(--white); font-family: 'Helvetica Neue', Arial, sans-serif;
    font-size: 14px;
  }
  .apply-form input::placeholder,
  .apply-form textarea::placeholder { color: #7c86a0; }
  .apply-form input:focus,
  .apply-form textarea:focus { outline: none; border-color: var(--gold); }
  .apply-form textarea { min-height: 100px; resize: vertical; }
  .apply-form .form-footer {
    margin-top: 20px; display: flex; align-items: center; gap: 18px; flex-wrap: wrap;
  }
  .form-status { font-family: 'Helvetica Neue', Arial, sans-serif; font-size: 14px; }
  .form-status[data-state="success"] { color: #6fd08c; }
  .form-status[data-state="error"] { color: #e08a8a; }

  /* NEXT MEETING */
  .meeting-card {
    display: flex; align-items: center; gap: 32px; background: var(--white);
    border: 1px solid var(--line); border-radius: 10px; padding: 36px; margin-top: 56px;
    flex-wrap: wrap;
  }
  .meeting-date {
    background: var(--cream); border: 1px solid var(--line); border-radius: 8px;
    padding: 18px 26px; text-align: center; font-family: 'Helvetica Neue', Arial, sans-serif;
  }
  .meeting-date .month { font-size: 12px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--gold); font-weight: 700; }
  .meeting-date .day { font-size: 34px; font-weight: 800; color: var(--navy-deep); line-height: 1.1; }
  .meeting-info h4 { font-size: 20px; color: var(--navy-deep); font-family: 'Helvetica Neue', Arial, sans-serif; }
  .meeting-info p { color: var(--slate); margin-top: 6px; font-size: 15px; }

  /* FOOTER */
  footer { background: var(--navy-deep); color: #9aa4bb; padding: 50px 0 30px; }
  footer .wrap { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 20px; }
  footer .brand { color: var(--white); }
  footer .fine { font-size: 13px; font-family: 'Helvetica Neue', Arial, sans-serif; }
  footer .foot-links { display: flex; gap: 22px; font-family: 'Helvetica Neue', Arial, sans-serif; font-size: 13px; }
  footer .foot-links a:hover { color: var(--gold-light); }

  @media (max-width: 860px) {
    nav.links { display: none; }
    .hero h1 { font-size: 36px; }
    .diff-grid, .membership-grid, .values-grid, .team-grid { grid-template-columns: 1fr; }
    .apply-top { flex-direction: column; align-items: flex-start; }
    .form-grid { grid-template-columns: 1fr; }
    .meeting-card { flex-direction: column; align-items: flex-start; }
  }
</style>
