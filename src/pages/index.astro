---
import Layout from '../layouts/Layout.astro';
import ApplyForm from '../components/ApplyForm.astro';
---

<Layout>

<header class="nav">
  <div class="wrap">
    <div class="brand"><span class="mark">G</span> GAIN GLOBAL NETWORKING</div>
    <nav class="links">
      <a href="#difference">Why Gain</a>
      <a href="#values">Values</a>
      <a href="#membership">Membership</a>
      <a href="#team">Leadership</a>
      <a href="#meeting">Next Meeting</a>
    </nav>
    <a href="#apply" class="nav-cta">Apply Now</a>
  </div>
</header>

<section class="hero">
  <div class="wrap">
    <div class="eyebrow">A Referral Networking Community</div>
    <h1>Networking that's actually <em>different</em>.</h1>
    <p class="lead">Gain Global Networking is built on consistency and accountability — the two things that turn a room of strangers into deep relationships, lasting referral partners, and lifelong friends.</p>
    <div class="hero-actions">
      <a href="#apply" class="btn btn-primary">Apply for Membership</a>
      <a href="#difference" class="btn btn-outline">See What Makes Us Different</a>
    </div>
    <div class="hero-meeting">
      <span class="dot"></span>
      <span>Next Meeting: <strong>Tupelo Honey</strong> — Tuesday, September 1, 2026 at 11:00 AM</span>
    </div>
  </div>
</section>

<section class="section" id="difference">
  <div class="wrap">
    <div class="kicker">Gain Global Is Different</div>
    <h2>Most networking is transactional. Ours isn't.</h2>
    <p class="section-lead">A business card exchange doesn't build a business. Consistency builds relationships. Accountability builds trust. That's the whole model.</p>

    <div class="diff-grid">
      <div class="diff-card no">
        <h3>Typical Networking</h3>
        <ul>
          <li>Random, one-off events</li>
          <li>Surface-level introductions</li>
          <li>No follow-through expected</li>
          <li>Transactional exchanges</li>
          <li>Easy come, easy go</li>
        </ul>
      </div>
      <div class="diff-card yes">
        <h3>Gain Global Networking</h3>
        <ul>
          <li>Bi-weekly, consistent meetings</li>
          <li>One exclusive seat per profession</li>
          <li>Monthly 1-on-1s to build real relationships</li>
          <li>Accountability built into the structure</li>
          <li>A true community, not a contact list</li>
        </ul>
      </div>
    </div>

    <div class="formula">
      <div class="sans">The Formula</div>
      <div class="formula-row">
        <span>Consistency</span><span class="plus">+</span><span>Accountability</span><span class="eq">=</span><span>Growth</span>
      </div>
      <div class="formula-outputs">
        <span class="chip">Deep Relationships</span>
        <span class="chip">Lasting Referral Partners</span>
        <span class="chip">Trusted Vendors</span>
        <span class="chip">Lifelong Friends</span>
      </div>
    </div>
  </div>
</section>

<section class="quote-block">
  <div class="wrap">
    <div class="mark-quote">&ldquo;</div>
    <h2>Who, not how.</h2>
    <p>You don't need to know how to do everything — you need to know who can. Gain Global Networking is where you find your "who."</p>
  </div>
</section>

<section class="section alt" id="values">
  <div class="wrap">
    <div class="kicker">What We Stand For</div>
    <h2>Core Values</h2>
    <p class="section-lead">Four principles guide every meeting, every member interaction, and every referral.</p>
    <div class="values-grid">
      <div class="value-card">
        <div class="glyph">G</div>
        <h4>Giving / Service</h4>
        <p>We show up to give first, trusting that generosity comes back around.</p>
      </div>
      <div class="value-card">
        <div class="glyph">F</div>
        <h4>Fun / Friendly</h4>
        <p>Business relationships should be enjoyable — we keep it warm and welcoming.</p>
      </div>
      <div class="value-card">
        <div class="glyph">I</div>
        <h4>Integrity / Honesty</h4>
        <p>Trust is the currency of referrals, and we protect it fiercely.</p>
      </div>
      <div class="value-card">
        <div class="glyph">Q</div>
        <h4>Quality / Excellence</h4>
        <p>We hold ourselves and our referrals to a high standard, every time.</p>
      </div>
    </div>
  </div>
</section>

<section class="section" id="membership">
  <div class="wrap">
    <div class="kicker">Membership</div>
    <h2>What membership looks like</h2>
    <p class="section-lead">One profession, one seat, one community that shows up for you.</p>
    <div class="membership-grid">
      <div class="membership-item">
        <div class="num">01</div>
        <div><h4>One Exclusive Seat Per Profession</h4><p>Your industry, yours to own — no internal competition for referrals.</p></div>
      </div>
      <div class="membership-item">
        <div class="num">02</div>
        <div><h4>Bi-Weekly Attendance</h4><p>Consistent meetings keep relationships warm and momentum going.</p></div>
      </div>
      <div class="membership-item">
        <div class="num">03</div>
        <div><h4>90-Second Weekly Intro</h4><p>Share your profession and your ideal referral — clear and specific, every time.</p></div>
      </div>
      <div class="membership-item">
        <div class="num">04</div>
        <div><h4>Monthly 1-on-1s</h4><p>Sit down with fellow members to build the relationships that drive real referrals.</p></div>
      </div>
      <div class="membership-item">
        <div class="num">05</div>
        <div><h4>Weekly Spotlight Presentation</h4><p>Get the floor to go deeper on who you are and how to refer you.</p></div>
      </div>
      <div class="membership-item">
        <div class="num">06</div>
        <div><h4>A Real Community</h4><p>Core Referrals is your community — trusted vendors, referral partners, lifelong friends.</p></div>
      </div>
    </div>
  </div>
</section>

<section class="section alt" id="team">
  <div class="wrap">
    <div class="kicker">Founding Leadership Team</div>
    <h2>Meet the people behind Gain Global</h2>
    <div class="team-grid">
      <div class="team-card">
        <div class="avatar">PS</div>
        <h4>Patrick Sweeney</h4>
        <div class="role">President</div>
      </div>
      <div class="team-card">
        <div class="avatar">TA</div>
        <h4>Terri Abellera</h4>
        <div class="role">Vice President</div>
        <div class="role2">Member Host</div>
      </div>
      <div class="team-card">
        <div class="avatar">SD</div>
        <h4>Star Darjuan</h4>
        <div class="role">Secretary</div>
        <div class="role2">Education Coordinator</div>
      </div>
      <div class="team-card">
        <div class="avatar">FA</div>
        <h4>Fernando Abellera</h4>
        <div class="role">Treasurer</div>
      </div>
    </div>
  </div>
</section>

<section class="section" id="apply">
  <div class="wrap">
    <div class="apply">
      <div class="apply-top">
        <div>
          <h3>Ready to find your "who"?</h3>
          <p>Applications are reviewed by our leadership team. One seat per profession is available, so don't wait to claim yours.</p>
          <div class="hero-actions" style="margin-top:24px;">
            <a href="mailto:info@gainglobalnetworking.com" class="btn btn-primary">Start Your Application</a>
          </div>
        </div>
        <div class="price">$400<span>Annual Membership Fee</span></div>
      </div>

      <ApplyForm />
    </div>
  </div>
</section>

<section class="section alt" id="meeting">
  <div class="wrap">
    <div class="kicker">Join Us</div>
    <h2>Next Meeting</h2>
    <p class="section-lead">Visitors are always welcome — come see what Gain Global Networking is about.</p>
    <div class="meeting-card">
      <div class="meeting-date">
        <div class="month">Sep</div>
        <div class="day">01</div>
      </div>
      <div class="meeting-info">
        <h4>Tupelo Honey</h4>
        <p>Tuesday, September 1, 2026 &middot; 11:00 AM</p>
        <p>Bring your 90-second intro and be ready to find your "who."</p>
      </div>
    </div>
  </div>
</section>

<footer>
  <div class="wrap">
    <div class="brand sans" style="font-weight:700;">GAIN GLOBAL NETWORKING</div>
    <div class="foot-links">
      <a href="#difference">Why Gain</a>
      <a href="#membership">Membership</a>
      <a href="#team">Leadership</a>
      <a href="#apply">Apply</a>
    </div>
  </div>
  <div class="wrap" style="margin-top:20px;">
    <span class="fine">&copy; 2026 Gain Global Networking. Consistency builds relationships. Accountability builds trust.</span>
  </div>
</footer>

</Layout>
