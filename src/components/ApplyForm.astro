---
// Cloudflare Turnstile site key (public — safe to ship in the page).
// The matching SECRET key lives only in Cloudflare Pages as TURNSTILE_SECRET_KEY,
// where functions/api/register.js uses it to check each submission.
// Set PUBLIC_TURNSTILE_SITE_KEY in Cloudflare Pages to override this at build time.
const TURNSTILE_SITE_KEY =
  import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '0x4AAAAAAFzXEgvv9kaTH4qe';
---

<div class="apply-form">
  <h4>Guest Registration - Free</h4>
  <form id="apply-form" action="/api/register" method="POST">
    <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off" />

    <div class="form-grid">
      <div>
        <label for="first_name">First Name</label>
        <input type="text" id="first_name" name="first_name" placeholder="Jane" required />
      </div>
      <div>
        <label for="last_name">Last Name</label>
        <input type="text" id="last_name" name="last_name" placeholder="Doe" required />
      </div>
      <div>
        <label for="email">Email Address</label>
        <input type="email" id="email" name="email" placeholder="jane@company.com" required />
      </div>
      <div>
        <label for="phone">Phone Number</label>
        <input type="tel" id="phone" name="phone" placeholder="(555) 555-5555" required />
      </div>
      <div>
        <label for="profession">Profession</label>
        <input type="text" id="profession" name="profession" placeholder="e.g. Real Estate Agent" required />
      </div>
      <div class="full">
        <label for="referred_by">Who referred you? (optional)</label>
        <input type="text" id="referred_by" name="referred_by" placeholder="Member or event name, if applicable" />
      </div>
      <div class="full consent-row">
        <input type="checkbox" id="email_optin" name="email_optin" />
        <label for="email_optin">Sign me up for email updates from GainGlobal Networking.</label>
      </div>
      <div class="full consent-row">
        <input type="checkbox" id="sms_optin" name="sms_optin" />
        <label for="sms_optin">By checking this box, I agree to receive SMS text messages from GainGlobal Networking (meeting reminders, event updates, and networking news) at the phone number provided above. Message frequency varies. Msg &amp; data rates may apply. Reply STOP to unsubscribe, HELP for help. Consent is not a condition of membership or attendance. View our <a href="/privacy" class="text-link">Privacy Policy</a>.</label>
      </div>
    </div>

    <div
      class="cf-turnstile turnstile-row"
      data-sitekey={TURNSTILE_SITE_KEY}
      data-action="guest-registration"
      data-theme="dark"
      data-size="flexible"
    ></div>

    <div class="form-footer">
      <button type="submit" class="btn btn-primary">Send Message</button>
      <span class="form-status" id="apply-form-status"></span>
    </div>
  </form>
</div>

<style>
  .consent-row {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-top: 4px;
  }
  .consent-row input[type='checkbox'] {
    width: 16px;
    height: 16px;
    margin-top: 3px;
    flex-shrink: 0;
    accent-color: var(--growth);
  }
  .consent-row label {
    display: block;
    text-transform: none;
    letter-spacing: normal;
    font-size: 13px;
    line-height: 1.5;
    color: rgba(246, 245, 241, 0.75);
    font-weight: 400;
    margin-bottom: 0;
  }
  .turnstile-row {
    margin-top: 20px;
    max-width: 400px;
  }
  .consent-row label a {
    text-decoration: underline;
    color: rgba(246, 245, 241, 0.92);
  }
</style>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
  const form = document.getElementById('apply-form') as HTMLFormElement | null;
  const status = document.getElementById('apply-form-status');
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

  type TurnstileApi = { reset: (el?: string | HTMLElement) => void };
  const resetTurnstile = () => {
    const ts = (window as unknown as { turnstile?: TurnstileApi }).turnstile;
    const widget = form?.querySelector<HTMLElement>('.cf-turnstile');
    if (ts && widget) ts.reset(widget);
  };

  const showError = (message: string) => {
    if (!status) return;
    status.textContent = message;
    status.setAttribute('data-state', 'error');
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!status) return;

    const formData = new FormData(form);

    if (!formData.get('cf-turnstile-response')) {
      showError('Please complete the security check before sending.');
      return;
    }

    status.textContent = 'Sending...';
    status.removeAttribute('data-state');
    if (button) button.disabled = true;

    try {
      // functions/api/register.js checks the Turnstile token, then passes the
      // submission on to n8n (Airtable, Google Sheet, Mailchimp, Salesmsg).
      const response = await fetch(form.action, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(Object.fromEntries(formData)),
      });
      const result = await response.json().catch(() => ({}));

      if (response.ok && result.success) {
        status.textContent = "Thanks! We'll be in touch soon.";
        status.setAttribute('data-state', 'success');
        form.reset();
        window.location.href = '/thank-you';
        return;
      }
      showError(result.message || 'Something went wrong. Please try again.');
    } catch (error) {
      showError('Something went wrong. Please try again.');
    }

    // Turnstile tokens are single-use, so get a fresh one before a retry.
    resetTurnstile();
    if (button) button.disabled = false;
  });
</script>
