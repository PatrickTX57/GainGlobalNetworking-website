# Cloudflare Turnstile (spam check on the Guest Registration form)
#
# Public site key — used at build time. Optional: ApplyForm.astro has the
# production site key hardcoded as a fallback.
PUBLIC_TURNSTILE_SITE_KEY=
#
# The following are read at runtime by functions/api/register.js. Set them in
# Cloudflare: Workers & Pages -> gainglobalnetworking-website -> Settings ->
# Variables and Secrets (type "Secret"). For local testing with
# `npx wrangler pages dev`, put them in a .dev.vars file (git-ignored).
#
# TURNSTILE_SECRET_KEY=   Turnstile widget secret key (required)
# N8N_FORM_SECRET=        shared secret sent to n8n as X-GGN-Form-Secret
# N8N_WEBHOOK_URL=        optional override of the n8n webhook URL
